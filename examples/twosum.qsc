# Two Sum using growable Quill lists and function parameters.

fn two_sum(numbers: Vec<number>, target: number) -> Vec<number> {
    let mut result: Vec<number> = [];

    for i in 0..len(numbers) {
        for j in i + 1..len(numbers) {
            if numbers[i] + numbers[j] == target {
                push(result, i);
                push(result, j);
                return result;
            }
        }
    }

    return result;
}

let numbers: Vec<number> = [2, 7, 11, 15];
let answer: Vec<number> = two_sum(numbers, 9);
say answer[0];
say answer[1];
