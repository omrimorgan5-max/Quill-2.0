import "../src/compiler/parser.qsc";

fn token_dump(tokens: Vec<string>) -> string {
    let mut output: string = "";
    for item in tokens {
        output = output + item + "\n";
    }
    return output;
}

let sample: string = "fn add(a: number) -> number { return a + 1; }";
let sample_tokens: Vec<string> = tokenize(sample);
if sample_tokens[0] == "keyword|fn" && sample_tokens[1] == "identifier|add" &&
    sample_tokens[2] == "symbol|(" {
    say "PASS Quill lexer tokens";
}
if parse_quill_source(sample) && !parse_quill_source("fn broken() { return 1;") {
    say "PASS Quill structural parser";
}

let input_path: string = argv(1);
let output_path: string = argv(2);
if input_path != "" && output_path != "" && file_exists(input_path) {
    let source: string = read_file(input_path);
    let tokens: Vec<string> = tokenize(source);
    if parse_quill_source(source) {
        write_file(output_path, token_dump(tokens));
        say "PASS bootstrap source validation";
    } else {
        say "Invalid Quill source structure";
    }
}
