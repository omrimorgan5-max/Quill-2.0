fn is_power_of_two(value: number) -> bool {
    if value <= 0 {
        return false;
    }
    while value % 2 == 0 {
        value = value / 2;
    }
    return value == 1;
}

fn sqrt_floor(value: number) -> number {
    if value < 2 {
        return value;
    }

    let mut low: number = 1;
    let mut high: number = value / 2;
    let mut answer: number = 1;
    while low <= high {
        let middle: number = low + (high - low) / 2;
        if middle <= value / middle {
            answer = middle;
            low = middle + 1;
        } else {
            high = middle - 1;
        }
    }
    return answer;
}

fn is_valid_parentheses(text: string) -> bool {
    let mut stack: Vec<number> = [];
    for index in 0..len(text) {
        let current: number = text[index];
        if current == 40 || current == 91 || current == 123 {
            push(stack, current);
            continue;
        }
        if len(stack) == 0 {
            return false;
        }
        let opening: number = pop(stack);
        if current == 41 && opening != 40 {
            return false;
        }
        if current == 93 && opening != 91 {
            return false;
        }
        if current == 125 && opening != 123 {
            return false;
        }
    }
    return len(stack) == 0;
}

fn remove_duplicates(values: Vec<number>) -> number {
    if len(values) == 0 {
        return 0;
    }

    let mut write_index: number = 1;
    for read_index in 1..len(values) {
        if values[read_index] == values[write_index - 1] {
            continue;
        }
        values[write_index] = values[read_index];
        write_index++;
    }
    return write_index;
}

fn add_binary(left: string, right: string) -> string {
    let mut left_index: number = len(left) - 1;
    let mut right_index: number = len(right) - 1;
    let mut carry: number = 0;
    let mut reversed: Vec<number> = [];

    while left_index >= 0 || right_index >= 0 || carry > 0 {
        let mut total: number = carry;
        if left_index >= 0 {
            total = total + left[left_index] - 48;
            left_index--;
        }
        if right_index >= 0 {
            total = total + right[right_index] - 48;
            right_index--;
        }
        push(reversed, total % 2);
        carry = total / 2;
    }

    let mut result: string = "";
    let mut index: number = len(reversed) - 1;
    while index >= 0 {
        result = result + toString(reversed[index]);
        index--;
    }
    return result;
}

fn add_strings(left: string, right: string) -> string {
    let mut left_index: number = len(left) - 1;
    let mut right_index: number = len(right) - 1;
    let mut carry: number = 0;
    let mut reversed: Vec<number> = [];

    while left_index >= 0 || right_index >= 0 || carry > 0 {
        let mut total: number = carry;
        if left_index >= 0 {
            total = total + left[left_index] - 48;
            left_index--;
        }
        if right_index >= 0 {
            total = total + right[right_index] - 48;
            right_index--;
        }
        push(reversed, total % 10);
        carry = total / 10;
    }

    let mut result: string = "";
    let mut index: number = len(reversed) - 1;
    while index >= 0 {
        result = result + toString(reversed[index]);
        index--;
    }
    return result;
}

fn multiply_strings(left: string, right: string) -> string {
    if left == "0" || right == "0" {
        return "0";
    }

    let mut digits: Vec<number> = [];
    let mut size_index: number = 0;
    while size_index < len(left) + len(right) {
        push(digits, 0);
        size_index++;
    }

    let mut left_index: number = len(left) - 1;
    while left_index >= 0 {
        let mut right_index: number = len(right) - 1;
        while right_index >= 0 {
            let position: number = left_index + right_index + 1;
            let product: number = (left[left_index] - 48) * (right[right_index] - 48) + digits[position];
            digits[position] = product % 10;
            digits[position - 1] = digits[position - 1] + product / 10;
            right_index--;
        }
        left_index--;
    }

    let mut start: number = 0;
    if digits[0] == 0 {
        start = 1;
    }
    let mut result: string = "";
    for index in start..len(digits) {
        result = result + toString(digits[index]);
    }
    return result;
}

fn power_value(base: double, exponent: number) -> double {
    let mut remaining: number = exponent;
    let mut factor: double = base;
    if remaining < 0 {
        factor = 1.0 / factor;
        remaining = -remaining;
    }

    let mut result: double = 1.0;
    while remaining > 0 {
        if remaining % 2 == 1 {
            result = result * factor;
        }
        factor = factor * factor;
        remaining = remaining / 2;
    }
    return result;
}

fn parse_integer(text: string) -> number {
    let mut index: number = 0;
    while index < len(text) && (text[index] == 32 || text[index] == 9 || text[index] == 10 || text[index] == 13) {
        index++;
    }

    let mut negative: bool = false;
    if index < len(text) && text[index] == 45 {
        negative = true;
        index++;
    } else if index < len(text) && text[index] == 43 {
        index++;
    }

    let mut value: number = 0;
    let mut last_digit_limit: number = 7;
    if negative {
        last_digit_limit = 8;
    }
    while index < len(text) {
        let digit: number = text[index] - 48;
        if digit < 0 || digit > 9 {
            break;
        }
        if value > 214748364 || (value == 214748364 && digit > last_digit_limit) {
            if negative {
                return -2147483647 - 1;
            }
            return 2147483647;
        }
        value = value * 10 + digit;
        index++;
    }
    if negative {
        return -value;
    }
    return value;
}

fn merge_sorted(first: Vec<number>, first_count: number, second: Vec<number>) -> void {
    let mut first_index: number = first_count - 1;
    let mut second_index: number = len(second) - 1;
    let mut output_index: number = first_count + len(second) - 1;

    while second_index >= 0 {
        if first_index >= 0 && first[first_index] > second[second_index] {
            first[output_index] = first[first_index];
            first_index--;
        } else {
            first[output_index] = second[second_index];
            second_index--;
        }
        output_index--;
    }
}

fn roman_value(symbol: number) -> number {
    if symbol == 73 { return 1; }
    if symbol == 86 { return 5; }
    if symbol == 88 { return 10; }
    if symbol == 76 { return 50; }
    if symbol == 67 { return 100; }
    if symbol == 68 { return 500; }
    if symbol == 77 { return 1000; }
    return 0;
}

fn roman_to_integer(text: string) -> number {
    let mut total: number = 0;
    for index in 0..len(text) {
        let current: number = roman_value(text[index]);
        if index + 1 < len(text) && current < roman_value(text[index + 1]) {
            total = total - current;
        } else {
            total = total + current;
        }
    }
    return total;
}

fn is_palindrome_number(value: number) -> bool {
    if value < 0 {
        return false;
    }
    let original: number = value;
    let mut reversed: number = 0;
    while value > 0 {
        reversed = reversed * 10 + value % 10;
        value = value / 10;
    }
    return original == reversed;
}

fn first_even_index(values: Vec<number>) -> number {
    let mut found: number = -1;
    for index in 0..len(values) {
        if values[index] % 2 == 0 {
            found = index;
            break;
        }
    }
    return found;
}

if is_power_of_two(1024) {
    say "PASS 231";
}
if sqrt_floor(8) == 2 {
    say "PASS 69";
}
if is_valid_parentheses("{[()]}") && !is_valid_parentheses("([)]") {
    say "PASS 20";
}
let mut sorted_values: Vec<number> = [0, 0, 1, 1, 2];
if remove_duplicates(sorted_values) == 3 && sorted_values[2] == 2 {
    say "PASS 26";
}
if add_binary("1010", "1011") == "10101" {
    say "PASS 67";
}
if add_strings("456", "77") == "533" {
    say "PASS 415";
}
if multiply_strings("123", "456") == "56088" {
    say "PASS 43";
}
if power_value(2.0, 10) == 1024.0 && power_value(2.0, -2) == 0.25 {
    say "PASS 50";
}
if parse_integer("  -42 words") == -42 && parse_integer("91283472332") == 2147483647 {
    say "PASS 8";
}
if roman_to_integer("MCMXCIV") == 1994 {
    say "PASS 13";
}
if is_palindrome_number(121) && !is_palindrome_number(-121) {
    say "PASS 9";
}
let mut merged: Vec<number> = [1, 2, 3, 0, 0, 0];
let second: Vec<number> = [2, 5, 6];
merge_sorted(merged, 3, second);
if merged[0] == 1 && merged[1] == 2 && merged[2] == 2 && merged[5] == 6 {
    say "PASS 88";
}
let control_values: Vec<number> = [1, 3, 8, 10];
if first_even_index(control_values) == 2 {
    say "PASS loop-control";
}